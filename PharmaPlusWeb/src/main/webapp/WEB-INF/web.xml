<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    
    <display-name>PharmaPlusWeb</display-name>
    
    <description>
        Sistema de Gestión de Inventario Farmacéutico con Alarmas Automáticas
    </description>
    
    <!-- Página de inicio -->
    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>
    
    <!-- ================================== -->
    <!-- SERVLETS -->
    <!-- ================================== -->
    
    <!-- Servlet Login -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.pharmaplus.servlets.LoginServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    
    <!-- Servlet Logout -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.pharmaplus.servlets.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    
    <!-- Servlet Inicio -->
    <servlet>
        <servlet-name>InicioServlet</servlet-name>
        <servlet-class>com.pharmaplus.servlets.InicioServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>InicioServlet</servlet-name>
        <url-pattern>/inicio</url-pattern>
    </servlet-mapping>
    
    <!-- Servlet Productos -->
    <servlet>
        <servlet-name>ProductoServlet</servlet-name>
        <servlet-class>com.pharmaplus.servlets.ProductoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProductoServlet</servlet-name>
        <url-pattern>/productos</url-pattern>
    </servlet-mapping>
    
    <!-- Servlet Alarmas -->
    <servlet>
        <servlet-name>AlarmaServlet</servlet-name>
        <servlet-class>com.pharmaplus.servlets.AlarmaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AlarmaServlet</servlet-name>
        <url-pattern>/alarmas</url-pattern>
    </servlet-mapping>
    
    <!-- ================================== -->
    <!-- API REST SERVLETS -->
    <!-- (Ya están anotados con @WebServlet) -->
    <!-- ================================== -->
    <!-- /api/productos/* - ProductoRestServlet -->
    <!-- /api/proveedores/* - ProveedorRestServlet -->
    <!-- /api/alarmas/* - AlarmaRestServlet -->
    
    <!-- ================================== -->
    <!-- FILTROS -->
    <!-- ================================== -->
    
    <!-- Filtro de Autenticación (ya anotado con @WebFilter) -->
    
    <!-- Filtro de Encoding UTF-8 -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>org.apache.catalina.filters.SetCharacterEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
        <init-param>
            <param-name>ignore</param-name>
            <param-value>false</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    
    <!-- ================================== -->
    <!-- CONFIGURACIÓN DE SESIÓN -->
    <!-- ================================== -->
    
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure> <!-- true en producción con HTTPS -->
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
    
    <!-- ================================== -->
    <!-- PÁGINAS DE ERROR -->
    <!-- ================================== -->
    
    <error-page>
        <error-code>404</error-code>
        <location>/error404.jsp</location>
    </error-page>
    
    <error-page>
        <error-code>500</error-code>
        <location>/error500.jsp</location>
    </error-page>
    
    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/error.jsp</location>
    </error-page>
    
    <!-- ================================== -->
    <!-- PARÁMETROS DE CONTEXTO -->
    <!-- ================================== -->
    
    <context-param>
        <param-name>app.name</param-name>
        <param-value>PharmaPlusWeb</param-value>
    </context-param>
    
    <context-param>
        <param-name>app.version</param-name>
        <param-value>1.0</param-value>
    </context-param>
    
    <!-- ================================== -->
    <!-- RECURSOS JDBC (opcional - alternativa a db.properties) -->
    <!-- ================================== -->
    <!--
    <resource-ref>
        <description>PharmaPlusDB Connection</description>
        <res-ref-name>jdbc/PharmaPlusDB</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
    </resource-ref>
    -->
    
</web-app>